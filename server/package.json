{
  "name": "menugo-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "seed": "node --env-file-if-exists=.env --import tsx src/scripts/seedDemo.ts",
    "create:user": "node --env-file-if-exists=.env --import tsx src/scripts/createUser.ts",
    "verify:auth": "node --env-file-if-exists=.env --import tsx src/scripts/verifyAuth.ts",
    "verify:manage-menu": "node --env-file-if-exists=.env --import tsx src/scripts/verifyManageMenu.ts",
    "verify:manage-orders": "node --env-file-if-exists=.env --import tsx src/scripts/verifyManageOrders.ts",
    "verify:manage-tables": "node --env-file-if-exists=.env --import tsx src/scripts/verifyManageTables.ts",
    "verify:orders": "node --env-file-if-exists=.env --import tsx src/scripts/verifyOrders.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "cloudinary": "^2.11.0",
    "connect-mongo": "6.0.0",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-session": "1.19.0",
    "file-type": "^22.2.0",
    "mongodb": "7.7.0",
    "mongoose": "9.11.3",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/express-session": "1.18.2",
    "@types/multer": "^2.3.0",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
