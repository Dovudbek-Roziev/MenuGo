# Порт локального HTTP-сервера.
PORT=4000

# Оставьте пустым для запуска без базы данных.
MONGO_URI=
# Пример только для локальной MongoDB без пароля:
# MONGO_URI=mongodb://127.0.0.1:27017/menugo

# Разрешённый источник запросов из браузера (CORS).
FRONTEND_URL=http://127.0.0.1:5173

# Секрет подписи сессий: создайте свой случайный секрет длиной не менее 32 символов.
# Не публикуйте его и не используйте примерное значение. Без него auth возвращает 503.
SESSION_SECRET=

# Для HTTPS в production установите NODE_ENV=production; cookie станет Secure.
# Для локального HTTP оставьте development (или не задавайте переменную).
# NODE_ENV=development
